# OpenAI API key (for GPT-4o-mini segmentation + TTS audio)
OPENAI_API_KEY=sk-...

# ElevenLabs API key (for ElevenLabs TTS voice generation)
ELEVENLABS_API_KEY=

# Serper.dev API key (free tier: 2500 queries/month) — https://serper.dev
SERPER_API_KEY=...

# Base URL of this server (used by Remotion renderer to access audio/image files)
BASE_URL=http://localhost:3000

# Supabase auth (public anon credentials)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Private beta/admin alerts
ADMIN_ALERT_EMAIL=tomas.marek.cz@gmail.com
RESEND_API_KEY=

# Gemini API key (direct Gemini Developer API, not Vertex AI)
# Get it from Google AI Studio: https://aistudio.google.com/app/apikey
# In Google Cloud Console the underlying API is usually named Generative Language API.
# For production, enable billing on the Google Cloud project connected to this key.
GEMINI_API_KEY=

# Optional Gemini model overrides.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-lite
GEMINI_CAPTION_MODEL=gemini-2.5-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# WhisperX forced-alignment server (Python/FastAPI — run: uvicorn alignment_server:app --port 8001)
# Used for precise word-level subtitle timing. Falls back to even split if unavailable.
ALIGNMENT_SERVER_URL=http://localhost:8001

# Storage provider
STORAGE_PROVIDER=r2
# Leave empty in production to prevent accidental Supabase Storage egress.
# Set to supabase only for a short, deliberate migration window.
STORAGE_FALLBACK_PROVIDER=

# Existing Supabase Storage fallback
SUPABASE_STORAGE_BUCKET=video-assets

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket
# Separate R2 bucket for reusable voice preview samples.
# If omitted, the app defaults to ai-editor-voice-previews.
R2_VOICE_PREVIEW_BUCKET=ai-editor-voice-previews
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_REGION=auto

# Signed URLs
R2_SIGNED_URL_EXPIRES_SECONDS=3600

# Optional: only if you set a public/custom domain for the bucket
R2_PUBLIC_BASE_URL=

# Worker controls
# Keep direct worker triggering enabled via WORKER_URL/WORKER_SECRET.
# This disables only background polling for queued render jobs.
WORKER_POLLING_DISABLED=true
# Scheduled YouTube publishing still relies on polling unless you add a separate scheduler.
WORKER_SCHEDULED_POLLING_DISABLED=false
# Set to false only while debugging; DB worker logs grow quickly during renders.
WORKER_DB_LOGS_DISABLED=true
WORKER_CLAIM_DEBUG=false
