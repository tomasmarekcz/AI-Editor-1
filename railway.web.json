{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build",
    "watchPatterns": [
      "app/**",
      "lib/**",
      "remotion/**",
      "types/**",
      "package.json",
      "package-lock.json",
      "railpack.json",
      "railway.web.json",
      "tsconfig.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
